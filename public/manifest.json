{
  "id": "/?source=pwa",
  "name": "YabatPresensi",
  "short_name": "YabatPresensi",
  "description": "Aplikasi Presensi GPS Pegawai Yayasan Anak Bangsa Aceh Tenggara",
  "lang": "id",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["tabbed", "standalone", "window-controls-overlay", "browser"],
  "background_color": "#ffffff",
  "theme_color": "#1e40af",
  "orientation": "portrait",
  "categories": ["business", "productivity", "utilities"],
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "play",
      "url": "https://play.google.com/store/apps/details?id=org.yabat.presensi",
      "id": "org.yabat.presensi"
    }
  ],
  "iarc_rating_id": "e84b072d-71b3-4d3e-86ae-31a8ce4e53b7",
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "file_handlers": [
    {
      "action": "/mobile/presensi",
      "name": "File Presensi",
      "accept": {
        "text/plain": [".txt"]
      }
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+presensi",
      "url": "/mobile/presensi?action=%s"
    }
  ],
  "share_target": {
    "action": "/mobile/presensi",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "scope_extensions": [
    {
      "origin": "https://stkip-us.ac.id"
    },
    {
      "origin": "https://yabatpresensi.stkip-us.ac.id"
    }
  ],
  "edge_side_panel": {
    "preferred_width": 480
  },
  "widgets": [
    {
      "name": "Presensi Cepat",
      "description": "Widget presensi GPS langsung dari layar utama",
      "tag": "presensi-widget",
      "template": "widget",
      "ms_ac_template": "widget.json",
      "data": "widget.json",
      "type": "application/json",
      "screenshots": [
        {
          "src": "/screenshot-narrow.png",
          "sizes": "720x1280",
          "label": "Tampilan Widget Presensi"
        }
      ],
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "note_taking": {
    "new_note_url": "/mobile/presensi"
  },
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Presensi GPS",
      "short_name": "Presensi",
      "description": "Buka halaman presensi masuk dan pulang",
      "url": "/mobile/presensi",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Riwayat Presensi",
      "short_name": "Riwayat",
      "description": "Lihat rekapitulasi kehadiran",
      "url": "/mobile/riwayat",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    }
  ],
  "screenshots": [
    {
      "src": "/screenshot-narrow.png",
      "sizes": "720x1280",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Tampilan Mobile Presensi"
    },
    {
      "src": "/screenshot-wide.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Tampilan Desktop Dashboard"
    }
  ]
}
